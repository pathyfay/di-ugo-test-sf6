{% extends 'base.html.twig' %}

{% block body %}

    <h1 class="text-decoration-underline">Détails du resource N°{{ resource.id }}</h1>
    <div class="app-left-50 p-4">
        <div>
            <strong>Civilité :</strong> {{ resource.title }}
        </div>
    </div>

    <div class="app-right-50 p-4">
        <div class="float-end rounded-image">
            {% if resource.photo is not null %}
                <img src="{{ resource.photo }}" alt="Image user">
            {% else %}
                <img src="{{ asset('build/images/user_default.png') }}" alt="Image user">
            {% endif %}
        </div>
    </div>

    <div class="border-2 app-grid-container">
        <form class="mb-4" action="{{ path('resource_list') }}" method="get" style="display: inline;">
            <button type="submit" class="btn btn-info m-3">Retour à la liste des resources</button>
        </form>
        <form class="float-end mb-4" action="{{ path('resource_edit', { id: resource.id }) }}" method="get"
              style="display: inline;">
            <button type="submit" class="btn btn-secondary m-1">Modifier</button>
        </form>

        <form class="float-end mb-4" action="{{ path('resource_delete', { id: resource.id }) }}" method="post"
              style="display: inline;"
              onsubmit="return confirm('Êtes-vous sûr de vouloir supprimer ce resource ?');">
            <button type="submit" class="btn btn-outline-danger m-1">Supprimer</button>
        </form>
        <hr>
    </div>
{% endblock %}

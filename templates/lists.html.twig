{% extends 'base.html.twig' %}

{% block title %}liste des {{ title }}{% endblock %}

{% block body %}
    <div class="app-width-100 mt-5 table-responsive">
        <h1 class="m-2">La liste des {{ title }}</h1>
        <div class="border-2 app-grid-container">
            <form class="float-end mb-4" action="{{ path(title|replace({'-': '_'}) ~ '_create') }}" method="get" style="display: inline;">
                <button type="submit" class="btn btn-info">Créer un {{ title }}</button>
            </form>
        </div>
        <table class="table table-striped table-bordered overflow-x-auto">
            <thead>
            <tr>
                {% if datas|length > 0 %}
                    {% for property in datas[0]|keys %}
                        <th class="text-center">{{ property|capitalize }}</th>
                    {% endfor %}
                    <th> Actions</th>
                {% endif %}
            </tr>
            </thead>
            <tbody>
            {% for data in datas %}
                <tr>
                    {% for property in data|keys %}
                        <td>
                            {% if attribute(data, property) is iterable %}
                                {{ attribute(data, property)|join(', ') }}
                            {% else %}
                                {{ attribute(data, property) }}
                            {% endif %}
                        </td>
                    {% endfor %}
                    <td>
                        <div class="btn-group">
                            {% if title == 'user'
                                or title == 'order'
                            %}
                                <form action="{{ path(title|replace({'-': '_'})  ~'_show', { id: data.id }) }}" method="get"
                                      style="display: inline;">
                                    <button type="submit" class="btn btn-outline-primary m-1">Voir</button>
                                </form>
                            {% endif %}
                            <form action="{{ path(title|replace({'-': '_'})  ~ '_edit', { id: data.id }) }}" method="get"
                                  style="display: inline;">
                                <button type="submit" class="btn btn-outline-secondary m-1">Modifier</button>
                            </form>
                            <form action="{{ path(title|replace({'-': '_'})  ~ '_delete', { id: data.id }) }}" method="post"
                                  style="display: inline;"
                                  onsubmit="return confirm('Êtes-vous sûr de vouloir supprimer cet élement ?');">
                                <button type="submit" class="btn btn-outline-danger m-1">Supprimer</button>
                            </form>
                        </div>
                    </td>
                </tr>
            {% endfor %}
            </tbody>
        </table>
    </div>

{% endblock %}
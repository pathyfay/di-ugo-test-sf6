{% extends 'base.html.twig' %}

{% block body %}
    <h1 class="text-decoration-underline mb-4 p-5">{{ objectForm.id ? 'Formulaire de ': 'Formulaire  ' }} {{ title|upper }}</h1>
    <fieldset class="border p-4 rounded shadow-lg app-form-70">
        <legend class="w-auto px-3 text-primary fw-semibold text-decoration-underline">
            {{ objectForm.id ? 'Modifier le formulaire' : 'Créer un formulaire' }}
        </legend>

        {{ form_start(form) }}
        {{ form_widget(form) }}

        <button class="btn btn-lg btn-success my-3 form-control"
                type="submit">{{ objectForm.id ? 'Modifier' : 'Envoyer' }}
        </button>
        {{ form_end(form) }}
    </fieldset>
{% endblock %}
